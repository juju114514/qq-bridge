{
  "name": "@juju114514/qq-bridge-plugin",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "main": "./index.js",
  "description": "qq-bridge 的 DSH 插件形态（薄插件 + 复用 src/core 与 sidecar）",
  "engines": {
    "node": ">=22.13"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "*",
    "@deepseek-ai/schemastery": "*",
    "@deepseek-ai/dsh-tools": "*",
    "@deepseek-ai/dsh-agent": "*",
    "@deepseek-ai/dsh-session": "*"
  },
  "files": [
    "index.js",
    "inbound.js",
    "channel.js",
    "agent-driver.js",
    "user-message.js",
    "dsh.plugin.json",
    "cordis.patch.yml",
    "tools.js",
    "sidecar.js",
    "chat-log.js",
    "vendor"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "dshx": {
    "contributes": {
      "tools": [
        "qqb_ping",
        "qqb_get_prompt",
        "qqb_send_message",
        "qqb_reply",
        "qqb_mark_read",
        "qqb_get_recent_messages",
        "qqb_get_unread_messages",
        "qqb_wait_for_messages"
      ]
    }
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/cordis": {
      "optional": true
    },
    "@deepseek-ai/schemastery": {
      "optional": true
    },
    "@deepseek-ai/dsh-tools": {
      "optional": true
    },
    "@deepseek-ai/dsh-agent": {
      "optional": true
    },
    "@deepseek-ai/dsh-session": {
      "optional": true
    }
  }
}
